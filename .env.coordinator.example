# Dedicated Privy test project. Never copy production Nightshade credentials.
# Only VITE_* is exposed to the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SHIELDTX_API_URL=http://127.0.0.1:4100/api/shieldtx
# Non-secret partner routing. Credentials use envPrefix + the names below.
# Additional partners can use e.g. PARTNER_B_ with their own app/signing keys.
PUBLIC_PRIVY_PARTNERS_JSON=[{"id":"stratium","envPrefix":"","allowedOrigins":["http://127.0.0.1:3000"],"executionEnabled":false,"warmTarget":2,"walletLimit":20}]
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# ES256 verification PUBLIC key from the Privy app; PEM, with literal or escaped newlines.
PRIVY_VERIFICATION_KEY=
PRIVY_BASE_URL=https://api.privy.io

# Runtime P-256 authorization key/quorum for the coordinator.
PRIVY_AUTHZ_KEY_ID=
PRIVY_AUTHZ_PRIVATE_KEY_PEM=
# PUBLIC PEM of that same runtime key, for admin/runtime separation checks.
PRIVY_AUTHZ_PUBLIC_KEY_PEM=
# Partner-owned policy-admin quorum ID only. Never put its private key here.
PRIVY_POLICY_ADMIN_QUORUM_ID=
# A different coordinator-held key/quorum may mutate recipient sets, not policies.
PRIVY_SET_MANAGER_QUORUM_ID=
PRIVY_SET_MANAGER_KEY_PEM=
# Shared Agent/open-close template + dedicated Solana signMessage policy,
# both created under the admin quorum in this same Privy project.
PRIVY_COSIGNER_POLICY_ID=
PRIVY_RELAY_POLICY_ID=

# Same builder/cap on server and coordinator. Both blank disables fees.
# f=10 means 1 basis point (0.01%); native-perps maximum f=100.
HL_BUILDER_ADDRESS=
HL_BUILDER_FEE_TENTHS_BPS=

# Dedicated state. Do not share DB/Redis with another coordinator.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/stratium_poc
REDIS_URL=redis://127.0.0.1:6379/8
BIND_ADDR=127.0.0.1:4100
# Legacy no-funds signing smoke guard. Public opens are gated by
# executionEnabled in PUBLIC_PRIVY_PARTNERS_JSON, not this value.
POC_EXECUTION_ENABLED=false
# At least 32 random bytes; internal operator routes only, never frontend auth.
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=stratium-shieldtx-poc
AUTH_JWT_ISSUER=stratium-shieldtx-poc

# Must match the test sequencer/solver/vault deployment.
SEQUENCER_RPC_URL=
SOLVER_NS_PUBLIC_KEY_HEX=
SOLVER_EXPECTED_SENDER_ADDRESS=
# At least 32 bytes; matching solver callbacks must target this coordinator.
SOLVER_WEBHOOK_SHARED_SECRET=
SOLVER_RECEIPT_INJECTION=false
NIGHTSHADE_OPEN_POSITION_USDC_ASSET_ID=0x75faf114eafb1bdbe2f0316df893fd58ce46aa4d
VAULT_ADDRESS=
IS_TESTNET=true
HL_SIGNATURE_CHAIN_ID=421614
HYPERLIQUID_REST_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
HYPEREVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PRIVY_GAS_SPONSORSHIP=true
DB_POOL_MAX_SIZE=10
SEQUENCER_RATE_LIMIT_PER_SECOND=25
HYPERLIQUID_RATE_LIMIT_PER_SECOND=25
PRIVY_RATE_LIMIT_PER_SECOND=10
REDIS_TRADE_TTL_SECS=604800
APP_ENV=development
