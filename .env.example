# Browser: public values only. Avail must allowlist APP_ORIGIN on the coordinator.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SHIELDTX_API_URL=
APP_ORIGIN=http://127.0.0.1:3000

# Partner onboarding server only. Never prefix these with NEXT_PUBLIC_.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
PRIVY_POLICY_ADMIN_QUORUM_ID=
PRIVY_POLICY_ADMIN_KEY_PEM=
PRIVY_SET_MANAGER_QUORUM_ID=
PRIVY_AUTHZ_KEY_ID=
# Production private Blob storage; development uses local .data/profiles/.
BLOB_READ_WRITE_TOKEN=

# Empty testnet setup. Must match the coordinator assigned to your Privy app.
# Current canary uses mainnet; see INTEGRATION.md for its separate settings.
IS_TESTNET=true
HL_SIGNATURE_CHAIN_ID=421614
VAULT_ADDRESS=
# Both blank disables builder fees. Otherwise match Avail's configuration.
HL_BUILDER_ADDRESS=
HL_BUILDER_FEE_TENTHS_BPS=
